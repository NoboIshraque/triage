{
  "name": "@triage/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The `triage` command line: build, simulate and test Triage projects headlessly (PLAN §4.10).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "triage": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@triage/sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
