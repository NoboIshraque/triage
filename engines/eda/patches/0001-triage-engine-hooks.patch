Hooks for Triage's EDA engine (ROADMAP P1-2, GUIDELINES §6).

- CMakeLists.txt builds engines/eda/triage/ when KICAD_TRIAGE_DIR is set.
- kiface_ids.h adds KIFACE_TRIAGE_ENGINE; with KICAD_TRIAGE defined, the
  pcbnew and eeschema kifaces return their Triage engine face for it (the code
  lives in engines/eda/triage/, compiled into the kifaces).

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 420f18bcb45530722c9c9385d357fa1fd85bbb0c..7ed178304d9627d0a4ef903a56fdc27e9ed31383 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1244,6 +1244,13 @@ add_subdirectory( kicad )               # should follow pcbnew, eeschema, api
 add_subdirectory( tools )
 add_subdirectory( utils )
 
+# Triage: the EDA engine host and the code it adds to the kifaces
+# (engines/eda/triage/ in the Triage repository, GUIDELINES §6).
+set( KICAD_TRIAGE_DIR "" CACHE PATH "Triage's engine sources (engines/eda/triage)" )
+if( KICAD_TRIAGE_DIR )
+    add_subdirectory( ${KICAD_TRIAGE_DIR} triage )
+endif()
+
 if( KICAD_BUILD_QA_TESTS )
     add_subdirectory( qa )
 endif()
