+
 // The main sheet of the project
 SCH_SHEET*  g_RootSheet = nullptr;
 
@@ -400,6 +405,11 @@ static struct IFACE : public KIFACE_BASE, public UNITS_PROVIDER
         {
             case KIFACE_NETLIST_SCHEMATIC:
                 return (void*) generateSchematicNetlist;
