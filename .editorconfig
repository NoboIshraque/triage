# Triage's own code. Forked upstream trees (app/, engines/*/upstream/) carry
# their own .editorconfig files, which take precedence inside them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,c,cc,cpp,h,hpp,py}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
